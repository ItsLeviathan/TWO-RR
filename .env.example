# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection string (Neon via the Vercel Marketplace, Vercel Postgres, Supabase, …).
# Use the POOLED connection string on Vercel. Leave empty locally to use embedded PGlite.
DATABASE_URL=

# ── Authentication ─────────────────────────────────────────────────────────
# Random string, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Owner account created by `npm run db:seed` / on deploy, only if that email doesn't exist yet.
# After the first sign-in, change the password in Admin → Settings and you may remove OWNER_PASSWORD.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Owner

# ── Image storage ──────────────────────────────────────────────────────────
# Vercel Blob read/write token (added automatically when you connect a Blob store in Vercel).
# Without it, uploads are disabled and images can be added by https:// link instead.
BLOB_READ_WRITE_TOKEN=
